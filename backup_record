USE railway;

SET @OLD_FK_CHECKS = @@FOREIGN_KEY_CHECKS;
SET FOREIGN_KEY_CHECKS = 0;
DROP TABLE IF EXISTS backup_record;
SET FOREIGN_KEY_CHECKS = @OLD_FK_CHECKS;

CREATE TABLE backup_record (
    backup_id     BIGINT AUTO_INCREMENT PRIMARY KEY,
    backup_type   ENUM('FULL','INCREMENTAL','OTHER')
                    NOT NULL DEFAULT 'FULL',
    status        ENUM('SUCCESS','FAIL','RUNNING')
                    NOT NULL DEFAULT 'SUCCESS',
    file_path     VARCHAR(500) NULL,           -- 백업 파일 위치
    started_at    DATETIME NULL,
    finished_at   DATETIME NULL,
    message       VARCHAR(255) NULL,           -- 간단한 메모/에러 이유
    created_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
)
ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4
COLLATE=utf8mb4_general_ci;

CREATE INDEX idx_backup_record_status
  ON backup_record (status, created_at);

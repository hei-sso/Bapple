USE railway;

SET @OLD_FK_CHECKS = @@FOREIGN_KEY_CHECKS;
SET FOREIGN_KEY_CHECKS = 0;
DROP TABLE IF EXISTS error_log;
SET FOREIGN_KEY_CHECKS = @OLD_FK_CHECKS;

CREATE TABLE error_log (
    error_id      BIGINT AUTO_INCREMENT PRIMARY KEY,
    level         ENUM('WARN','ERROR','FATAL') NOT NULL DEFAULT 'ERROR',
    service_name  VARCHAR(100) NULL,           -- 어떤 서비스/모듈에서 났는지
    error_code    VARCHAR(50) NULL,            -- 애플리케이션 에러 코드
    message       TEXT NOT NULL,               -- 에러 메시지
    stack_trace   MEDIUMTEXT NULL,             -- 스택 트레이스
    request_info  JSON NULL,                   -- 요청 정보 (URL, params 등)
    created_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
)
ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4
COLLATE=utf8mb4_general_ci;

CREATE INDEX idx_error_log_level_created
  ON error_log (level, created_at);

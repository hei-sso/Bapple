USE railway;

--  FK 임시 해제
SET @OLD_FK_CHECKS = @@FOREIGN_KEY_CHECKS;
SET FOREIGN_KEY_CHECKS = 0;

-- 기존 테이블 삭제
DROP TABLE IF EXISTS report;

-- FK 원복
SET FOREIGN_KEY_CHECKS = @OLD_FK_CHECKS;

-- 신고 테이블 생성
CREATE TABLE report (
    report_id      BIGINT AUTO_INCREMENT PRIMARY KEY,     -- 신고 pk

    -- 누가 신고했는지
    reporter_id    BIGINT NOT NULL,                       -- 신고자(user)

    -- 무엇을 신고했는지 (타입 + ID 조합으로 관리)
    target_type    ENUM('USER','RECIPE','GROUP','CHAT','OTHER')
                   NOT NULL,
    target_id      BIGINT NULL,                           -- 대상의 pk (user_id, recipe_id 등)

    -- 신고 내용
    reason_code    VARCHAR(50) NULL,                      -- 사유 코드 (예: SPAM, ABUSE 등)
    description    TEXT NULL,                             -- 상세 사유(사용자 입력)

    -- 처리 상태
    status         ENUM('PENDING','PROCESSING','RESOLVED','REJECTED')
                   NOT NULL DEFAULT 'PENDING',
    resolution_note TEXT NULL,                            -- 처리 메모

    handled_by     BIGINT NULL,                           -- 처리한 관리자 ID (user 테이블)
    handled_at     DATETIME NULL,                         -- 처리 완료 시간

    created_at     TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at     TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
                        ON UPDATE CURRENT_TIMESTAMP,

    -- FK
    CONSTRAINT fk_report_reporter
        FOREIGN KEY (reporter_id) REFERENCES user(user_id)
        ON DELETE CASCADE,

    CONSTRAINT fk_report_handler
        FOREIGN KEY (handled_by) REFERENCES user(user_id)
        ON DELETE SET NULL
)
ENGINE = InnoDB
DEFAULT CHARSET = utf8mb4
COLLATE = utf8mb4_general_ci;

-- 인덱스 (상태/시간별 조회)
CREATE INDEX idx_report_status_created
  ON report (status, created_at);

CREATE INDEX idx_report_target
  ON report (target_type, target_id);
